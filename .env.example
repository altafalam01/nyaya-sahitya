APP_NAME=nyaya-sahitya
APP_ENV=development
LOG_LEVEL=INFO
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
CHUNKS_DATA_DIR=data/chunks
ANTHROPIC_API_KEY=
USER_AGENT=NyayaSahityaBot/0.1 (legal-research; non-commercial)
DOWNLOAD_DELAY_SECONDS=5

# Optional: full path to tesseract.exe if it is not on PATH (used for OCR of scanned pages)
TESSERACT_CMD=

# Step 5: vector index
CHROMA_DIR=data/index
EMBED_MODEL=intfloat/multilingual-e5-small
EMBED_BATCH_SIZE=16

# Step 6: hybrid retrieval
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
DENSE_CANDIDATES=50
BM25_CANDIDATES=50
RERANK_TOP=20
